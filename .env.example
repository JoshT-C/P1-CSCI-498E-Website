# Copy to .env on the server (gitignored) and fill in.
#
# Which nginx config set is active:
#   http-only  — first boot: serves the site on :8080 and exposes the
#                ACME challenge webroot so the certificate can be issued.
#   full       — post-cert: 301 http→https, TLS, HSTS, security headers.
# Flip with: sed -i 's/^NGINX_CONF=.*/NGINX_CONF=full/' .env
NGINX_CONF=http-only

# Public domain (must already resolve to this server).
DOMAIN=jtc.lopyhupis.com

# Address for Let's Encrypt expiry notices.
CERT_EMAIL=you@example.com
